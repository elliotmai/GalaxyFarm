# Copy to .env.local and fill in. Never put real values in this file.

# Neon now, a box in the barn later. Plain Postgres over TCP only — no
# provider-proprietary APIs (spec §2), which is what keeps the move home a
# connection-string change.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Cloudflare R2 — S3-compatible, so a home MinIO swaps in later.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_ENDPOINT=""

RESEND_API_KEY=""

# Shared secret for /api/cron/weather (§6). The scheduler sends it as
# `Authorization: Bearer <value>` or `X-Cron-Secret`. With this unset the route
# refuses every call rather than running open — an unauthenticated cron
# endpoint is a way to spend somebody else's forecast quota.
CRON_SECRET=""

# Maps JavaScript API key, browser-restricted. Its own Google Cloud billing
# account; 10,000 free loads a month covers this many times over (§8).
GOOGLE_CLOUD_PROJECT_ID=""
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Generate with (works on Windows, macOS, and Linux alike):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Farm and business names are BrandingConfig values (§5.1), stored in settings
# with these as fallbacks. Never string literals in code.
NEXT_PUBLIC_FARM_NAME="Flying Double M"
NEXT_PUBLIC_BUSINESS_NAME=""

# The crawled association graph (Neo4j Aura), which holds every animal the
# crawler found rather than only the ones this herd descends from. Read-only
# from the app's side: the catalogue is searched, and an animal is copied
# across into the ancestors when somebody asks for it.
#
# Aura names the database after the instance, so NEO4J_DATABASE is usually the
# instance id rather than "neo4j". The URI may be given in either the
# neo4j+s:// or https:// form.
#
# Leave these empty and the catalogue search simply reports that it is not
# configured — nothing else on the site depends on it.
NEO4J_URI=""
NEO4J_USERNAME=""
NEO4J_PASSWORD=""
NEO4J_DATABASE=""
