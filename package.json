{
  "name": "galaxy-farm",
  "version": "0.0.0",
  "private": true,
  "description": "Local-first PWA for a family beef-cattle operation and homestead",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "verify": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test:coverage && pnpm run build",
    "db:generate": "pnpm --filter @galaxy-farm/infra-db db:generate",
    "db:baseline": "dotenv -e .env.local -- pnpm --filter @galaxy-farm/infra-db db:baseline",
    "db:migrate": "dotenv -e .env.local -- pnpm --filter @galaxy-farm/infra-db db:migrate",
    "db:migrate:deployed": "pnpm --filter @galaxy-farm/infra-db db:migrate",
    "db:seed": "dotenv -e .env.local -- pnpm --filter @galaxy-farm/web db:seed",
    "db:user": "dotenv -e .env.local -- pnpm --filter @galaxy-farm/web db:user",
    "vapid:keys": "pnpm --filter @galaxy-farm/infra-push vapid:keys"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "^2.1.8",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.17.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vitest": "^2.1.8"
  }
}
