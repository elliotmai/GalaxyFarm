# The working copy lives on an exFAT volume, which has no symlinks, and pnpm's
# default layout is built entirely out of them. Hoisted is the only linker that
# works there.
#
# What this costs: a flat node_modules lets a package import something it never
# declared and still run. That guarantee is not given up — it moves to
# `tests/architecture/boundaries.test.ts`, which fails the build on any import
# of a package the importer's package.json does not list. Committed rather than
# set per-machine so CI checks what a developer actually runs.
node-linker=hoisted
