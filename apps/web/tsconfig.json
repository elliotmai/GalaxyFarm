{
  "extends": "../../packages/config/tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "allowJs": true,
    "incremental": true,
    // The app is the end of the graph: nothing imports its types, so there is
    // no declaration to emit and no reason to enforce that every inferred type
    // be nameable from outside. next-auth's inferred `auth` cannot be, and
    // demanding it is a check with no consumer. The packages keep it on.
    "declaration": false,
    "declarationMap": false,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", ".next", "e2e"]
}
