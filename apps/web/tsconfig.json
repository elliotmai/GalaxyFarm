{
  "extends": "../../packages/config/tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "allowJs": true,
    "incremental": true,
    // The app is the end of the graph: nothing imports its types, so there is
    // no declaration to emit and no reason to enforce that every inferred type
    // be nameable from outside. next-auth's inferred `auth` cannot be, and
    // demanding it is a check with no consumer. The packages keep it on.
    "declaration": false,
    "declarationMap": false,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.mts", "**/*.tsx", ".next/types/**/*.ts"],
  // The service worker is typechecked by `tsconfig.sw.json` instead. It runs in
  // a worker global scope, not a window, and `lib.dom` and `lib.webworker`
  // cannot both be loaded into one program — they declare the same names with
  // different shapes. So the app keeps the DOM and the worker gets its own
  // pass; `pnpm typecheck` in this package runs both.
  "exclude": ["node_modules", ".next", "e2e", "app/sw.ts", "public/sw.js"]
}
